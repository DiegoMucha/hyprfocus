# OpenAI Responses API
OPENAI_API_KEY=tu_api_key_de_openai_aqui
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1

# Rutas de Whisper en la Raspberry Pi
WHISPER_CLI_PATH=/home/juanjose/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=/home/juanjose/whisper.cpp/models/ggml-base.bin
WHISPER_THREADS=4

# Rutas de Piper en la Raspberry Pi
PIPER_BIN=piper
PIPER_MODEL_PATH=/home/juanjose/tts/es_AR-daniela-high.onnx
PIPER_CONFIG_PATH=/home/juanjose/tts/es_AR-daniela-high.onnx.json

# Opciones de audio y red
PLAY_ON_PI_SPEAKER=true
HOST=0.0.0.0
PORT=8000

# Hyprfocus (Visión Computacional y Activación por Puño Cerrado)
HYPRFOCUS_CAMERA=picamera2
HYPRFOCUS_DEVICE=0
SYSTEM_PYTHON_DIST_PACKAGES=/usr/lib/python3/dist-packages
REQUIRE_CLOSED_FIST=true
FIST_ACTIVATION_TIMEOUT=8.0
AUTO_START_VISION=true
VISION_STARTUP_TIMEOUT=30.0
FIST_TRIGGER_COOLDOWN=2.0

# Micrófono ALSA local. Usa `arecord -L` para listar dispositivos.
MICROPHONE_DEVICE=default
MICROPHONE_RECORD_SECONDS=5.0
